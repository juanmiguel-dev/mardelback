---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/urls';
import { shortDescription } from '../lib/text';
import fuentes from '../data/fuentes.json';

const totalColecciones = fuentes.reduce((acc, f) => acc + f.colecciones.length, 0);
const totalRegistros = fuentes.reduce(
  (acc, f) => acc + f.colecciones.reduce((x, c) => x + c.items.length, 0),
  0,
);

const homeCards = fuentes.map((fuente) => {
  const hasMultiple = fuente.colecciones.length > 1;
  if (hasMultiple) {
    const fuenteRegistros = fuente.colecciones.reduce((acc, c) => acc + c.items.length, 0);
    const thumb =
      fuente.colecciones.find((c) => c.slug === 'postales')?.thumbnail ||
      fuente.colecciones[0]?.thumbnail ||
      '';
    const nombres = fuente.colecciones.map((c) => c.name).join(', ');
    return {
      href: withBase(`fuentes/${fuente.id}/`),
      thumb,
      kicker: fuente.nombre,
      title: `Catálogo ${fuente.nombre}`,
      meta: `${fuente.colecciones.length} colecciones · ${fuenteRegistros} registros`,
      desc: shortDescription(`Incluye: ${nombres}.`, 140),
    };
  }

  const c = fuente.colecciones[0];
  return {
    href: withBase(`colecciones/${c.slug}/`),
    thumb: c.thumbnail || '',
    kicker: fuente.nombre,
    title: c.name,
    meta: `${c.itemCount} ${c.itemCount === 1 ? 'registro' : 'registros'}`,
    desc: shortDescription(c.description || fuente.descripcion, 140),
  };
});
---

<Layout>
  <section class="hero" data-reveal>
    <h1>MARDELBACK</h1>
    <p>
      {fuentes.length} {fuentes.length === 1 ? 'fuente' : 'fuentes'} · {totalColecciones} colecciones ·{' '}
      {totalRegistros} registros
    </p>
  </section>

  <section class="masonry">
    {
      homeCards.map((card) => (
        <article class="card" data-reveal>
          <a class="card-link" href={card.href}>
            <div class="card-cover">
              {card.thumb ? (
                <img src={withBase(card.thumb)} alt={`Portada de ${card.title}`} loading="lazy" />
              ) : (
                <span class="cover-fallback">🏛️</span>
              )}
            </div>
            <div class="card-body">
              <span class="photo-card-kicker">{card.kicker}</span>
              <h2 class="card-title">{card.title}</h2>
              <p class="card-meta">
                <span>{card.meta}</span>
              </p>
              {card.desc && <p class="card-desc">{card.desc}</p>}
            </div>
          </a>
        </article>
      ))
    }
  </section>
</Layout>
