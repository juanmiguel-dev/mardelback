---
import Layout from '../../layouts/Layout.astro';
import ItemCard from '../../components/ItemCard.astro';
import colecciones from '../../data/colecciones.json';

export function getStaticPaths() {
  return colecciones.map((coleccion) => ({
    params: { slug: coleccion.slug },
    props: { coleccion },
  }));
}

const { coleccion } = Astro.props;
const items = coleccion.items;
---

<Layout title={coleccion.name}>
  <nav class="breadcrumb">
    <a href="/">Colecciones</a> / <span>{coleccion.name}</span>
  </nav>

  <section class="hero small">
    <h1>{coleccion.name}</h1>
    <p>{items.length} {items.length === 1 ? 'registro' : 'registros'}</p>
    {coleccion.description && <p class="hero-desc">{coleccion.description}</p>}
  </section>

  <section class="toolbar">
    <input type="search" id="search" placeholder="Buscar en esta colección…" autocomplete="off" />
  </section>

  <p id="result-count" class="result-count"></p>

  <section class="grid" id="grid">
    {items.map((item) => (
      <ItemCard item={item} coleccionSlug={coleccion.slug} />
    ))}
  </section>
</Layout>

<script>
  const search = document.getElementById('search') as HTMLInputElement;
  const resultCount = document.getElementById('result-count') as HTMLParagraphElement;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.card'));

  function applyFilter() {
    const q = search.value.trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const haystack = (card.dataset.search || card.textContent || '').toLowerCase();
      const show = !q || haystack.includes(q);
      card.style.display = show ? '' : 'none';
      if (show) visible += 1;
    }
    resultCount.textContent =
      visible === cards.length
        ? `${cards.length} registros`
        : `${visible} de ${cards.length} registros`;
  }

  search.addEventListener('input', applyFilter);
  applyFilter();
</script>
