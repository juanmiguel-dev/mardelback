---
import Layout from '../../../layouts/Layout.astro';
import { withBase } from '../../../lib/urls';
import fuentes from '../../../data/fuentes.json';

export function getStaticPaths() {
  return fuentes.flatMap((fuente) =>
    fuente.colecciones.flatMap((coleccion) =>
      coleccion.items.map((item) => ({
        params: { slug: coleccion.slug, item: item.slug },
        props: { coleccion, item, fuente },
      })),
    ),
  );
}

const { coleccion, item, fuente } = Astro.props;

const isPdf =
  /pdf/i.test(item.documentMimetype || '') ||
  /\.pdf$/i.test((item.documentUrl || '').split('?')[0]);
const isImage = !isPdf && /^image\//.test(item.documentMimetype || '');

const docSrc = item.document || item.documentUrl || '';
const thumbSrc = item.thumbnail || item.thumbnailUrl || '';

const allMeta = item.metadata || [];
const description = item.description || allMeta.find((m) => m.name === 'Descripción')?.value || '';
const fields = allMeta.filter((m) => m.name !== 'Título' && m.name !== 'Descripción');
---

<Layout title={item.title}>
  <nav class="breadcrumb" data-reveal>
    <a href={withBase('/')}>Catálogo</a> /
    {fuente.colecciones.length > 1 && (
      <>
        <a href={withBase(`fuentes/${fuente.id}/`)}>{fuente.nombre}</a> /
      </>
    )}
    <a href={withBase(`colecciones/${coleccion.slug}/`)}>{coleccion.name}</a> /
    <span>{item.title}</span>
  </nav>

  <article class:list={['detalle', { 'detalle--single': isImage }]}>
    {
      !isImage && (
        <div class="detalle-cover" data-reveal>
          {thumbSrc ? (
            <img src={withBase(thumbSrc)} alt={`Portada de ${item.title}`} />
          ) : (
            <span class="cover-fallback">📄</span>
          )}
        </div>
      )
    }

    <div class="detalle-info" data-reveal>
      <span class="detalle-vol">{coleccion.name}</span>
      <h1>{item.title}</h1>
      {description && (
        <div class="desc-block">
          <span class="desc-label">Descripción</span>
          <p class="detalle-desc">{description}</p>
        </div>
      )}

      {fields.length > 0 && (
        <dl class="metadatos">
          {fields.map((m) => (
            <div>
              <dt>{m.name}</dt>
              <dd>
                {m.value.split(' | ').length > 1 ? (
                  <span class="chips">
                    {m.value.split(' | ').map((p) => (
                      <span class="chip">{p}</span>
                    ))}
                  </span>
                ) : (
                  m.value
                )}
              </dd>
            </div>
          ))}
        </dl>
      )}

      <div class="acciones">
        {docSrc && (
          <a class="btn" href={withBase(docSrc)} target="_blank" rel="noopener">
            {isPdf ? 'Abrir PDF' : 'Ver imagen completa'}
          </a>
        )}
        {item.document && (
          <a class="btn btn-outline" href={withBase(item.document)} download>
            Descargar
          </a>
        )}
        {item.urlOriginal && (
          <a class="btn btn-outline" href={item.urlOriginal} target="_blank" rel="noopener">
            Ficha original
          </a>
        )}
      </div>
    </div>
  </article>

  {isPdf && docSrc && (
    <section class="visor" data-reveal>
      <h2>Lectura en línea</h2>
      <iframe class="visor-frame" src={withBase(docSrc)} title={`PDF de ${item.title}`}></iframe>
    </section>
  )}

  {isImage && docSrc && (
    <section class="visor" data-reveal>
      <h2>Documento</h2>
      <img class="visor-img" src={withBase(docSrc)} alt={item.title} loading="lazy" />
    </section>
  )}
</Layout>
