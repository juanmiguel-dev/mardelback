---
import Layout from '../../../layouts/Layout.astro';
import colecciones from '../../../data/colecciones.json';

export function getStaticPaths() {
  return colecciones.flatMap((coleccion) =>
    coleccion.items.map((item) => ({
      params: { slug: coleccion.slug, item: item.slug },
      props: { coleccion, item },
    })),
  );
}

const { coleccion, item } = Astro.props;

const isPdf =
  /pdf/i.test(item.documentMimetype || '') ||
  /\.pdf$/i.test((item.documentUrl || '').split('?')[0]);
const isImage = !isPdf && /^image\//.test(item.documentMimetype || '');

const viewerSrc = item.document || item.documentUrl || '';
const coverSrc = isImage ? viewerSrc : item.thumbnail || item.document || '';
---

<Layout title={item.title}>
  <nav class="breadcrumb">
    <a href="/">Colecciones</a> /
    <a href={`/colecciones/${coleccion.slug}/`}>{coleccion.name}</a> /
    <span>{item.title}</span>
  </nav>

  <article class="detalle">
    <div class:list={['detalle-cover', { 'detalle-cover--image': isImage }]}>
      {coverSrc ? (
        <img src={coverSrc} alt={item.title} />
      ) : (
        <span class="cover-fallback">📄</span>
      )}
    </div>

    <div class="detalle-info">
      <h1>{item.title}</h1>
      <p class="detalle-vol">{coleccion.name}</p>

      {item.description && <p class="detalle-desc">{item.description}</p>}

      {item.metadata && item.metadata.length > 0 && (
        <dl class="metadatos">
          {item.metadata.map((m) => (
            <div>
              <dt>{m.name}</dt>
              <dd>{m.value}</dd>
            </div>
          ))}
        </dl>
      )}

      <div class="acciones">
        {viewerSrc && (
          <a class="btn" href={viewerSrc} target="_blank" rel="noopener">
            {isPdf ? 'Abrir PDF' : 'Ver documento'}
          </a>
        )}
        {item.document && (
          <a class="btn btn-outline" href={item.document} download>
            Descargar
          </a>
        )}
        {item.urlOriginal && (
          <a class="btn btn-outline" href={item.urlOriginal} target="_blank" rel="noopener">
            Ver ficha original
          </a>
        )}
      </div>
    </div>
  </article>

  {isPdf && viewerSrc && (
    <section class="visor">
      <h2>Lectura en línea</h2>
      <iframe class="visor-frame" src={viewerSrc} title={`PDF de ${item.title}`}></iframe>
    </section>
  )}
</Layout>
