---
import { withBase } from '../lib/urls';
import { shortDescription } from '../lib/text';

interface Props {
  item: {
    id: number;
    title: string;
    slug: string;
    description?: string;
    thumbnail?: string;
    thumbnailUrl?: string;
    document?: string;
    documentUrl?: string;
    metadata?: { name: string; value: string }[];
  };
  coleccionSlug: string;
}

const { item, coleccionSlug } = Astro.props;
const thumbSrc = item.thumbnail || item.thumbnailUrl || '';

const summary =
  shortDescription(item.description, 140) ||
  shortDescription(
    (item.metadata || []).slice(0, 3).map((m) => m.value).join(' · '),
    140,
  );
---

<article
  class="card"
  data-reveal
  data-search={`${item.title} ${item.description || ''} ${(item.metadata || []).map((m) => m.value).join(' ')}`}
>
  <a class="card-link" href={withBase(`colecciones/${coleccionSlug}/${item.slug}/`)}>
    <div class="card-cover">
      {thumbSrc ? (
        <img src={withBase(thumbSrc)} alt={item.title} loading="lazy" />
      ) : (
        <span class="cover-fallback">📄</span>
      )}
    </div>
    <div class="card-body">
      <h2 class="card-title">{item.title}</h2>
      {summary && <p class="card-desc">{summary}</p>}
    </div>
  </a>
</article>
