---
import { withBase } from '../lib/urls';
import { shortDescription } from '../lib/text';

interface Props {
  coleccion: {
    id: number;
    name: string;
    slug: string;
    description?: string;
    itemCount: number;
    thumbnail?: string;
  };
}

const { coleccion } = Astro.props;
const desc = shortDescription(coleccion.description, 150);
---

<article class="card" data-reveal>
  <a class="card-link" href={withBase(`colecciones/${coleccion.slug}/`)}>
    <div class="card-cover">
      {coleccion.thumbnail ? (
        <img src={withBase(coleccion.thumbnail)} alt={`Portada de ${coleccion.name}`} loading="lazy" />
      ) : (
        <span class="cover-fallback">📚</span>
      )}
    </div>
    <div class="card-body">
      <h2 class="card-title">{coleccion.name}</h2>
      <p class="card-meta">
        <span>{coleccion.itemCount} {coleccion.itemCount === 1 ? 'registro' : 'registros'}</span>
      </p>
      {desc && <p class="card-desc">{desc}</p>}
    </div>
  </a>
</article>
